;; macOS sandbox for `make hero` (#551): the README hero capture runs on NO real
;; login, and the kernel enforces it for the whole process tree (bun, the demo
;; server, claude, Chromium). Reads of the operator's real credential stores and
;; the keychain CLI are DENIED, so a regression that tries to use them fails the
;; capture instead of risking a token refresh that signs the operator out.
;; Used as: sandbox-exec -D HOME="$HOME" -f hero-no-credentials.sb <cmd>
(version 1)
(allow default)
(deny file-read* file-write*
  (subpath (string-append (param "HOME") "/.codex"))
  (subpath (string-append (param "HOME") "/.gemini"))
  (literal (string-append (param "HOME") "/.claude/.credentials.json"))
  (subpath (string-append (param "HOME") "/Library/Keychains")))
(deny process-exec (literal "/usr/bin/security"))
