<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron needs JIT for V8 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for loading our bundled server binary (when invoked by
         the local-install flow). Without this, dlopen of any unsigned .dylib
         fails with hardened runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network: the desktop talks HTTP/WS to autonomos-server. Outbound for
         remote connections; the local-install flow may also have us speak to
         127.0.0.1 which is technically "client" too. We do not act as a
         network server ourselves. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
