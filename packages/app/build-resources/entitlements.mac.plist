<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron apps when hardened-runtime is enabled. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- We spawn the autonomos-server child process — needs dyld/exec rights. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- The server makes outbound HTTP calls (GitHub API for upgrade,
         hook relay POSTs from spawned CC sessions to localhost). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The server LISTENS on a localhost port for the webview. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- node-pty spawns child processes (the bundled `claude` CLI etc.). -->
    <key>com.apple.security.inherit</key>
    <false/>
</dict>
</plist>
