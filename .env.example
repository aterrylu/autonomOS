# ── Tailscale Sidecar ──────────────────────────────────────
# Required for `make prod` / `docker compose up`
# Creates a dedicated Tailscale node: http://autonomos
#
# 1. Go to https://login.tailscale.com/admin/settings/oauth
# 2. Create an OAuth client with scope: auth_keys
# 3. Tag the key with your desired ACL tag (e.g., tag:homelab)
# 4. Copy the key below
TS_AUTHKEY=tskey-client-XXXX?ephemeral=true&preauthorized=true

# ── Claude Usage Tracking ─────────────────────────────────
# Shows your Claude rate limits (5h session, 7d weekly) in the
# dashboard status bar. Uses claude.ai's internal usage API.
#
# To get your session cookie:
# 1. Go to https://claude.ai
# 2. Open DevTools (Cmd+Option+I) → Application → Cookies
# 3. Copy the "sessionKey" value
# 4. Paste it below
#
# The cookie is long-lived and won't expire unless you log out of
# claude.ai. If it stops working, repeat the steps above.
CLAUDE_SESSION_COOKIE=sessionKey=sk-ant-sid01-XXXX
