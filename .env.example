# ── Authentication ────────────────────────────────────────
# Optional. When set, the dashboard requires this token to access
# API and WebSocket endpoints. The login page is shown automatically.
# Leave unset or empty to disable auth (open access).
# AUTONOMOS_TOKEN=your-secure-token-here

# ── Deployment ────────────────────────────────────────────
# Used by `make deploy` to rsync + restart on a remote host.
# DEPLOY_HOST=your-server-hostname
# DEPLOY_PATH=~/autonomOS

# ── Claude Usage Tracking ─────────────────────────────────
# Shows your Claude rate limits (5h session, 7d weekly) in the
# dashboard status bar. Uses claude.ai's internal usage API.
#
# To get these values:
# 1. Go to https://claude.ai
# 2. Open DevTools (Cmd+Option+I) → Application → Cookies
# 3. Copy the "sessionKey" cookie value from .claude.ai
# 4. Copy the "lastActiveOrg" cookie value (UUID) from .claude.ai
#    ⚠️  There may also be a lastActiveOrg under anthropic.com — ignore that one.
#    Make sure you pick the one under .claude.ai
#
# Both are long-lived and won't expire unless you log out of
# claude.ai. If usage tracking stops working, repeat the steps above.
CLAUDE_SESSION_KEY=sk-ant-sid01-XXXX
CLAUDE_ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
