node_modules/
dist/
build/
# Phase 1A.1: server build scripts (committed) — override generic build/ ignore
!packages/server/build/
# Phase 1A.1: staging dir for dashboard assets copied at binary build time
packages/server/src/_embedded_dashboard/
.env
.env.local
.DS_Store
*.tsbuildinfo
.vite/
.mcp.json
deploy/serve.json.deploy
.playwright-mcp/
# Playwright e2e (L4) output — reports, traces, screenshots, cached browsers
packages/dashboard/test-results/
packages/dashboard/playwright-report/
packages/dashboard/blob-report/
packages/dashboard/.playwright/
.autonomos-dev/
# Generated by scripts/install-prod-service.sh — the from-source service wrapper.
.autonomos-bin/
# Per-package changelogs are transient — changesets writes them, but the
# single root CHANGELOG.md (assembled by scripts/sync-changelog.ts) is the
# canonical product history. See .changeset/README.md.
packages/*/CHANGELOG.md

# Ad-hoc QA / dev screenshots dropped in the repo root during sessions — they
# accumulate and clutter `git status`. Committed images live in docs/assets/,
# not the root, so a root-only ignore is safe. (Existing stray root PNGs can be
# deleted anytime; this just keeps new ones out of the way.)
/*.png
/*.gif

# deploy-time copy of scripts/install.sh (site.yml) — never commit
website/install.sh

# Managed-clone install marker (ADR-077 source mode) — written at the repo
# root by scripts/install-source.sh and rewritten by `autonomos upgrade`.
# Never tracked: the updater's dirty-tree refusal must not trip over it.
/install.json
